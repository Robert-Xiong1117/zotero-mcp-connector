# Enter real values only in your cloud host's secret settings or private .env.cloud.
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_API_KEY=
ZOTERO_MCP_PUBLIC_URL=https://your-service.example.com
# Random password, at least 24 characters, for MCP browser authorization.
ZOTERO_MCP_ADMIN_PASSWORD=
# Exact trusted HTTPS client metadata URLs, comma-separated, if your client uses CIMD.
# Leave blank for Dynamic Client Registration (DCR). Never allow arbitrary user URLs.
ZOTERO_CIMD_URLS=
PORT=8000
ZOTERO_CLOUD_DATA_DIR=/data
